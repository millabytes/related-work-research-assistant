APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=related_work
POSTGRES_USER=related_work
POSTGRES_PASSWORD=change_me_locally
# Optional override: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/db
# STORAGE_ROOT defaults to this project directory in the source checkout.
RAW_PDFS_DIR=data/raw_data/papers
PROCESSED_DIR=data/processed
OUTPUT_DIR=data/outputs
MODEL_CACHE_DIR=models_cache/huggingface

GROBID_URL=http://localhost:8070
GROBID_TIMEOUT=180
ZOTERO_RDF=data/raw_data/zotero_metadata.rdf
CHUNK_MIN_TOKENS=200
CHUNK_TARGET_TOKENS=300
CHUNK_MAX_TOKENS=400
RERANKER_DEVICE=auto
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16
# Optional immutable SHA/tag override: RERANKER_REVISION=
RWA_API_URL=http://127.0.0.1:8000
GENERATION_DEVICE=auto
PRIMERA_MAX_NEW_TOKENS=256
PRIMERA_MIN_NEW_TOKENS=56
PRIMERA_NUM_BEAMS=4
PRIMERA_LENGTH_PENALTY=2.0
QWEN_MAX_NEW_TOKENS=384
GENERATION_SAFETY_MARGIN=256
GENERATION_POLL_SECONDS=2
GENERATION_STALE_MINUTES=60
# Optional revision/tag/SHA overrides; the worker resolves them to immutable SHAs.
# PRIMERA_REVISION=
# QWEN_REVISION=
